# ─── LLM Decision Brain Configuration ──────────────────────────────────────
# Set your Gemini API key (Recommended) or OpenAI API key.
# If no key is set, the swarm autonomously utilizes its built-in local ReAct engine.
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Provider options: "auto", "gemini", "openai", "local"
LLM_PROVIDER=auto

# Model options:
# Gemini: "gemini-1.5-flash", "gemini-1.5-pro", "gemini-2.0-flash"
# OpenAI: "gpt-4o-mini", "gpt-4o"
LLM_MODEL=gemini-1.5-flash

# ─── Database Configuration (SQLite default, or PostgreSQL URI) ──────────────
# SQLite (Zero-config local dev):
DATABASE_URL=sqlite:///supply_chain_swarm.db
# PostgreSQL (Production connection pooling):
# DATABASE_URL=postgresql://swarm_user:swarm_pass@localhost:5432/supply_chain_swarm
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ─── API Caching, Rate Limiting & Circuit Breaker ────────────────────────────
WEATHER_CACHE_TTL_SECONDS=300
DISASTER_CACHE_TTL_SECONDS=180
ROUTING_CACHE_TTL_SECONDS=600
RATE_LIMIT_MAX_CALLS=60
RATE_LIMIT_PERIOD_SECONDS=60
CIRCUIT_BREAKER_THRESHOLD=2
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ─── External Services (Zero API Key Required) ──────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OSRM_BASE_URL=http://router.project-osrm.org/route/v1/driving

